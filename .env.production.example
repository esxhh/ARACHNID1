# Copy these values into your PowerShell environment before running run-prod.ps1.
$env:DJANGO_SECRET_KEY = "replace-with-a-long-random-secret"
$env:DJANGO_ALLOWED_HOSTS = "127.0.0.1,localhost"
$env:DJANGO_DEBUG = "0"
$env:SENTINEL_HUB_CLIENT_ID = "replace-with-copernicus-oauth-client-id"
$env:SENTINEL_HUB_CLIENT_SECRET = "replace-with-copernicus-oauth-client-secret"
$env:SENTINEL_MONITOR_BBOX = "54,24,56,26"
$env:SENTINEL_MONITOR_INTERVAL_SECONDS = "900"
